# Installed as /etc/higherpays/backup-drive.env with root:root ownership and
# mode 0600. Keep this file out of git.
#
# Leave false until the Google Drive service account and rclone crypt remote
# are configured. The weekly timer will still create the local backup.
BACKUP_GOOGLE_DRIVE_UPLOAD=false

# rclone remote name, including the trailing colon. This must be a crypt remote
# so uploaded dump contents are encrypted before they leave the VPS.
BACKUP_GOOGLE_DRIVE_REMOTE=higherpays-drive-crypt:

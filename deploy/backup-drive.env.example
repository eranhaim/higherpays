# Installed as /etc/higherpays/backup-drive.env with root:root ownership and
# mode 0600. Keep this file out of git.
#
# Leave false until the Drive folder, service-account key, and encrypted rclone
# remote are configured. The weekly timer will still create the local backup.
BACKUP_GOOGLE_DRIVE_UPLOAD=false

# Customer-provided destination. Do not put the Drive URL or credentials in git.
BACKUP_GOOGLE_DRIVE_FOLDER_ID=
BACKUP_GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=/etc/higherpays/google-drive-service-account.json

# rclone remote name, including the trailing colon. This must be a crypt remote.
BACKUP_GOOGLE_DRIVE_REMOTE=

# Local backup retention. The weekly service defaults to 30 when unset.
BACKUP_KEEP_LOCAL=30

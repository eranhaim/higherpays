# Copy to deploy.env and fill in. deploy.env is gitignored - it stays on your
# machine and is never committed.
#
# This file is sourced by deploy.sh as shell, so quote any value containing
# spaces.

# user@host of the production server
HIGHERPAYS_HOST="ubuntu@0.0.0.0"

# Absolute path to the ssh private key
HIGHERPAYS_KEY="/path/to/key.pem"

# Where the repo is checked out on the server.
# Defaults to /home/ubuntu/higherpays when unset.
# HIGHERPAYS_DIR="/home/ubuntu/higherpays"

[Unit]
Description=HigherPays weekly PostgreSQL backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/deploy/higherpays
Environment=BACKUP_DIR=/var/backups/higherpays
Environment=KEEP_LOCAL=30
UMask=0077
ExecStart=/bin/sh /home/deploy/higherpays/deploy/backup-postgres-weekly.sh

# Copy to .env next to docker-compose.yml before `docker compose up`. Never
# commit the .env file — only this template.
#
# The backend container receives this whole file (env_file), so every setting
# the API reads lives here. Compose refuses to start without the secrets.

# --- Postgres ---------------------------------------------------------------
# The database superuser password (used by migrations only).
POSTGRES_PASSWORD=
# The restricted app-role password. Rotate by shelling into the postgres
# container and running: ALTER ROLE hp_app PASSWORD '<new>';
HP_APP_PASSWORD=

# --- Backend ----------------------------------------------------------------
NODE_ENV=production
# At least 32 random characters. Generate: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
SUPPORTED_CURRENCIES=EUR
# Payment-link expiry in minutes (also sent to MantaPay as ExpiredOn).
LINK_TTL_MINUTES=10

# Public base URL of the API, used to build each workspace's webhook URL.
# Production: https://higherpays.com/api
WEBHOOK_PUBLIC_BASE=

# --- Seed (first boot only) -------------------------------------------------
# Set to `true` for a first-time boot to create the first agency + owner user.
SEED_ON_BOOT=false
SEED_ORG=Demo Agency
SEED_NAME=Demo Owner
SEED_EMAIL=owner@example.com
SEED_PASSWORD=change-me-please
SEED_MID=
SEED_PSP_RATE=7
SEED_MARGIN_RATE=5
SEED_CREATOR_SPLIT=70
SEED_CHATTER_PCT=10
SEED_CHARGEBACK_FEE=60

# --- MantaPay: hosted checkout (leave empty to keep the provider offline) ----
MANTAPAY_MERCHANT_ID=
MANTAPAY_HASH_KEY=
MANTAPAY_HOSTED_BASE=https://uiservices.mantapay.biz
MANTAPAY_PROCESS_BASE=https://process.mantapay.biz

# --- MantaPay: Search API (per-transaction fee reconciliation) --------------
# API-user credentials issued by MantaPay support; they expire every 90 days.
MANTAPAY_SEARCH_BASE=https://webservices.mantapay.biz
MANTAPAY_APP_TOKEN=
MANTAPAY_API_EMAIL=
MANTAPAY_API_PASSWORD=
MANTAPAY_SEARCH_SALT=

# --- MantaPay: refunds ------------------------------------------------------
# Provider-side refunds are not implemented; the app records refunds issued in
# the MantaPay dashboard. Leave false.
MANTAPAY_REFUND_ENABLED=false

# --- Telegram notifications -------------------------------------------------
# One HigherPays-owned bot delivers to every workspace's chat (create via @BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org

# --- Backups (deploy/backup-postgres.sh) ------------------------------------
# S3 bucket that receives nightly dumps. Leave empty to keep dumps local only.
BACKUP_S3_BUCKET=

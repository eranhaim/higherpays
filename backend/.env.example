# ─── HigherPays backend — environment ────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env.

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PGUSER=hp_app
PORT=3000

# Postgres. Run MIGRATIONS as the owner, run the APP as a restricted role.
# (the server refuses to boot in production if it is not).
DATABASE_URL=postgres://hp_app:CHANGE_ME@localhost:5432/higherpays

# Long random string. Production refuses to start with the default.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Row-Level Security IS the tenant boundary. MUST be true in production.

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Public base URL of this backend — used to build each workspace's notify URL.
PUBLIC_BASE_URL=https://api.higherpays.com
# Overrides PUBLIC_BASE_URL for provider callbacks only (e.g. a tunnel while testing).
# MantaPay's WAF blocks localhost URLs, so a public tunnel is required in dev.
WEBHOOK_PUBLIC_BASE=

# ── Currency ─────────────────────────────────────────────────────────────────
# EUR-only for now. FX conversion is deliberately out of scope; adding a second
# currency here re-opens every question in PROVIDER-CONSTRAINTS.md #6.
SUPPORTED_CURRENCIES=EUR

# ── MantaPay: hosted payment page ────────────────────────────────────────────
MANTAPAY_HOSTED_BASE=https://uiservices.mantapay.biz
MANTAPAY_MERCHANT_ID=            # your 7-digit merchant number
MANTAPAY_HASH_KEY=               # PersonalHashKey — signs requests AND verifies notifications

# Per-workspace override: workspaces.provider_config_ref names an env var holding
# that workspace's own hash key, e.g. MANTAPAY_HASH_KEY_AURORA=xxxx
# Keys are NEVER stored in the database.

# How long a payment link stays valid (also sent as MantaPay's ExpiredOn).
LINK_TTL_MINUTES=10

# ── MantaPay: status check (DIFFERENT host) ──────────────────────────────────
MANTAPAY_PROCESS_BASE=https://process.mantapay.biz

# ── MantaPay: Search API / reconciliation (THIRD host) ───────────────────────
# Returns PER-TRANSACTION fees. Needs an API-user login (role 50) — ask support
# for dedicated API credentials so portal password changes don't break this.
# Credentials expire every 3 months.
MANTAPAY_SEARCH_BASE=https://webservices.mantapay.biz
MANTAPAY_APP_TOKEN=              # issued by MantaPay support
MANTAPAY_API_EMAIL=
MANTAPAY_API_PASSWORD=
# Salt used to sign Search API request bodies. If blank we fall back to the
# "Signature" field returned by login — UNCONFIRMED, see OPEN-QUESTIONS #12.
MANTAPAY_SEARCH_SALT=

# ── MantaPay: refunds ────────────────────────────────────────────────────────
# Their refund flow is a two-step request approved by their admins and is NOT
# implemented yet. While false, the console RECORDS refunds issued in their
# dashboard rather than calling an API.
MANTAPAY_REFUND_ENABLED=false

# ── Notifications ────────────────────────────────────────────────────────────
# One HigherPays-owned Telegram bot serves every workspace; agencies configure
# only a chat id. Create via @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org

# ── Seed data (npm run seed) — development only ──────────────────────────────
# Two demo agencies with a login per role. Fees, splits and agency names live
# in src/util/seed.js, not here.
SEED_PASSWORD=change-me-please
SEED_PLATFORM_ADMIN=platform@higherpays.test
